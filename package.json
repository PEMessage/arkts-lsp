{
  "name": "arkts-lsp",
  "version": "0.3.0",
  "description": "One-click standalone ArkTS language server: bundles DevEco Studio's extracted ace-server and the vendored arkts-lsp-proxy fork (git submodule), and uses the official HarmonyOS command-line tools",
  "license": "MIT",
  "bin": {
    "arkts-lsp": "bin/arkts-lsp.mjs",
    "arkts-lsp-extract": "extractor/extract-ace-server.mjs"
  },
  "files": [
    "bin/",
    "extractor/",
    "ace-server-*/**/*",
    "vendor/harmony_arkts_lsp_proxy/dist/",
    "vendor/harmony_arkts_lsp_proxy/package.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:proxy": "bash scripts/build-proxy.sh",
    "pretest": "bash scripts/build-proxy.sh",
    "test": "node --test test/*.test.mjs",
    "smoke": "node scripts/smoke.mjs",
    "extract": "node extractor/extract-ace-server.mjs"
  },
  "keywords": [
    "arkts",
    "arkui",
    "harmonyos",
    "openharmony",
    "deveco",
    "lsp",
    "language-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PEMessage/arkts-lsp.git"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "vscode-jsonrpc": "^8.2.1"
  }
}
